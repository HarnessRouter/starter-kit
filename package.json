{
  "name": "harnessrouter-demo-at-harvard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "demos/*"
  ],
  "scripts": {
    "dev": "npm run dev:cursor",
    "dev:cursor": "npm run dev --workspace=@harnessrouter/cursor-coding-app",
    "dev:lumacare": "npm run dev --workspace=@harnessrouter/lumacare",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "preview:cursor": "npm run preview --workspace=@harnessrouter/cursor-coding-app",
    "preview:lumacare": "npm run preview --workspace=@harnessrouter/lumacare"
  }
}
